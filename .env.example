# Copiez ce fichier en ".env" et renseignez vos identifiants réels.
# L'application essaie SendGrid en premier, puis le SMTP classique si
# SendGrid n'est pas configuré (les deux blocs ci-dessous sont facultatifs
# individuellement, mais au moins un des deux doit être rempli pour que
# l'envoi d'email fonctionne réellement).

# ---- Option 1 : SendGrid (API HTTPS — nécessaire sur PythonAnywhere gratuit) ----
# Créez un compte gratuit sur sendgrid.com, vérifiez un "Single Sender"
# (Settings > Sender Authentication), puis créez une clé API (Settings > API Keys).
SENDGRID_API_KEY=
SENDGRID_FROM=

# ---- Option 2 : SMTP classique (bloqué sur PythonAnywhere gratuit) ----
# Exemple avec Gmail : créez un "mot de passe d'application" (pas votre mot de passe normal)
# sur https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application
SMTP_FROM=votre-adresse@gmail.com

# Port utilisé par le serveur web (Render/Railway le définissent automatiquement)
PORT=5000
